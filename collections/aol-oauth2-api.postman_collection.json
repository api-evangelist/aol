                        "type": "text/plain"
                      },
                      "key": "code",
                      "value": "<string>"
                    },
                    {
                      "disabled": false,
                      "description": {
                        "content": "Previously issued refresh token (required when grant_type=refresh_token)",
                        "type": "text/plain"
                      },
                      "key": "refresh_token",
                      "value": "<string>"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"access_token\": \"string\",\n  \"token_type\": \"bearer\",\n  \"expires_in\": 2088,\n  \"refresh_token\": \"string\",\n  \"id_token\": \"string\",\n  \"xoauth_yahoo_guid\": \"string\"\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
